#!/bin/sh
# Before every commit: words that must not enter this repository, then the tests.
# Enabled by: git config core.hooksPath scripts/hooks
# The words are extended regular expressions, one per line, in .git/info/forbidden-patterns (local, never
# committed). Without that file only the tests run.

PATTERNS="$(git rev-parse --git-dir)/info/forbidden-patterns"
if [ -s "$PATTERNS" ]; then
  HITS=$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -v '^+++' | grep -inE -f "$PATTERNS" | head -5)
  if [ -n "$HITS" ]; then
    echo "pre-commit: these added lines contain words listed in $PATTERNS:"
    echo "$HITS"
    exit 1
  fi
fi

if ! output=$(swift test 2>&1); then
  echo "$output" | grep -E "error|failed|XCTAssert" | head -30
  echo "pre-commit: tests failed, commit stopped."
  exit 1
fi
echo "$output" | grep -E "Executed [0-9]+ tests" | tail -1
